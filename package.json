{
  "name": "pixel-wizards-charachters",
  "version": "1.5.0",
  "description": "Data-driven, AI-drivable animated children's characters for the web — emotion, gaze, gestures, locomotion and Persian-viseme lip-sync as one JSON frame. Zero runtime dependencies, React optional.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedafzali/PixelWizardsCharachters.git"
  },
  "homepage": "https://github.com/hamedafzali/PixelWizardsCharachters#readme",
  "bugs": {
    "url": "https://github.com/hamedafzali/PixelWizardsCharachters/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "demo": "npm run build && node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "sheet": "npm run build && node tools/sheet.mjs",
    "mutate": "node tools/mutate.mjs",
    "baseline": "npm run build && node tools/baseline.mjs",
    "speech-gap": "npm run build && node tools/speech-gap.mjs",
    "syllable-probe": "npm run build && node tools/syllable-probe.mjs"
  },
  "keywords": [
    "characters",
    "character-animation",
    "avatar",
    "svg",
    "lip-sync",
    "viseme",
    "persian",
    "farsi",
    "children",
    "kids",
    "ai-agent",
    "text-to-viseme",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "author": "hamed.afzali <afzali.hamed@gmail.com>",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
